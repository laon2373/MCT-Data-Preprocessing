# 기업 원본 데이터
data/*
!data/.gitkeep

# 전처리 결과 파일
output/*
!output/.gitkeep

# 실제 기업 데이터 기반 추론 분석 결과
reports/inference/

# 추론 파이프라인 검증용 백업 파일
src/inference_pipeline_verified.py

# Python 캐시 파일
__pycache__/
*.py[cod]

# Python 가상환경
.venv/
venv/

# 환경변수 및 비밀정보
.env

# Jupyter Notebook 임시 파일
.ipynb_checkpoints/

# 운영체제 및 편집기 파일
.DS_Store
Thumbs.db
.vscode/